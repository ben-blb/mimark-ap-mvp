# Copia este archivo a .env (pnpm bootstrap lo hace por ti). Nunca subas .env al repositorio.
# En Vercel estas variables se configuran en el proyecto "api" (ver infra/README.md).

# --- Base de datos ---
# Local: Postgres de infra/docker-compose.yml. En Neon: la URL con pooling.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimark
# Solo Neon: conexión directa para migraciones (la integración Neon-Vercel la crea sola).
# DATABASE_URL_UNPOOLED=

# --- Acceso ---
# Hash del código "mimark-local" (SOLO para desarrollo local).
# Genera el de producción con: pnpm --filter @mimark/api access:hash "<código largo>"
ACCESS_CODE_HASH='scrypt$_r6FOWDFRkY6qVpSekWd-A$u6honQimSZ3ljPZEd-WoKf22WJSB4K47IA_uggN4TUk'
# En producción: 32+ caracteres aleatorios (por ejemplo: openssl rand -base64 48).
SESSION_SECRET=dev-only-change-me-this-is-not-a-real-secret

# --- Negocio ---
BUSINESS_TZ=America/Monterrey

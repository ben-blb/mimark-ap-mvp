// Modelo de datos. Cada spec que agrega tablas o columnas las define aquí y crea su migración:
//   pnpm db:migrate --name <spec>-<cambio>
// Nunca edites una migración ya aplicada; crea una nueva.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  MXN
  USD
}

/// Proveedor y sus condiciones de pago (spec 002).
model Supplier {
  id         String   @id @default(cuid())
  name       String
  /// RFC normalizado (mayúsculas, sin espacios).
  taxId      String   @unique
  /// Días de crédito; 0 = contado.
  creditDays Int
  currency   Currency
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  payables       Payable[]
}

enum PurchaseOrderStatus {
  open
  cancelled
}

enum ReceiptStatus {
  pending
  received
}

/// Orden de compra y su recepción (spec 003).
model PurchaseOrder {
  id            String              @id @default(cuid())
  /// Folio normalizado, p. ej. "OC-1001".
  number        String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  issuedOn      DateTime            @db.Date
  /// Total esperado CON impuestos (regla de negocio de CxP).
  total         Decimal             @db.Decimal(14, 2)
  currency      Currency
  parlevelRef   String?
  status        PurchaseOrderStatus @default(open)
  receiptStatus ReceiptStatus       @default(pending)
  receivedOn    DateTime?           @db.Date
  receivedBy    String?
  receiptNotes  String?
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  payables      Payable[]

  @@index([supplierId])
}

enum PayableStatus {
  uploaded
  processing
  requires_review
  pending_confirmation
  confirmed
  scheduled
  paid
  out_of_scope
  failed
  discarded
}

enum DocStatus {
  pending
  received
}

enum DocType {
  factura
  ticket
  remision
  otro
}

/// Expediente de cuentas por pagar: un documento, su extracción, la decisión y (spec 005) el pago.
model Payable {
  id                String         @id @default(cuid())
  status            PayableStatus  @default(uploaded)
  createdBy         String
  /// Archivo original, nunca se modifica. La llave no incluye el nombre del archivo.
  fileKey           String
  fileName          String
  mimeType          String
  fileSize          Int
  /// Datos que da quien sube.
  selectedPoNumber  String?
  /// Fecha en que CxP recibió el documento; base del vencimiento (spec 005).
  invoiceReceivedOn DateTime       @db.Date
  /// Salida de la IA tal cual: { data, model, promptVersion, ms }. Inmutable.
  extraction        Json?
  /// Campos vigentes (la spec 005 permite corregirlos).
  isApDocument      Boolean?
  docType           DocType?
  supplierName      String?
  supplierTaxId     String?
  invoiceNumber     String?
  issueDate         DateTime?      @db.Date
  poNumber          String?
  subtotal          Decimal?       @db.Decimal(14, 2)
  taxes             Decimal?       @db.Decimal(14, 2)
  total             Decimal?       @db.Decimal(14, 2)
  currency          Currency?
  taxUuid           String?
  uncertainFields   String[]       @default([])
  /// Decisión de las reglas, p. ej. ["MISSING_FIELD:total", "RECEIPT_NOT_CONFIRMED"].
  reviewReasons     String[]       @default([])
  failureCode       String?
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierId        String?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  /// Spec 005: vencimiento y ciclo de pago (miércoles y viernes).
  dueOn             DateTime?      @db.Date
  suggestedPayOn    DateTime?      @db.Date
  urgent            Boolean        @default(false)
  scheduledPayOn    DateTime?      @db.Date
  /// Se llenan al confirmar. Únicos: la base impide confirmar dos veces la misma factura.
  uuidKey           String?        @unique
  /// "RFC|FOLIO"
  folioKey          String?        @unique
  paidOn            DateTime?      @db.Date
  paidAmount        Decimal?       @db.Decimal(14, 2)
  paymentRef        String?
  invoiceDocStatus  DocStatus?
  complementStatus  DocStatus?
  discardReason     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([taxUuid])
  @@index([supplierTaxId, invoiceNumber])
  @@index([purchaseOrderId])
}

/// Registro de auditoría (spec 001). Una fila por acción relevante; nunca se edita ni se borra.
/// También sirve para cuotas de uso y para rastrear una petición por su requestId.
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actor      String
  role       String?
  requestId  String
  /// Tipo de registro afectado: "supplier", "session", "payable"...
  entity     String
  entityId   String?
  /// Verbo en pasado con prefijo de entidad: "supplier.created", "session.failed"...
  action     String
  fromStatus String?
  toStatus   String?
  /// Detalle: diff de campos, modelo de IA, duración, IP... Nunca el contenido del documento.
  data       Json?

  @@index([entity, entityId])
  @@index([action, at])
  @@index([requestId])
}
